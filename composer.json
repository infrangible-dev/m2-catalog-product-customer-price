{
    "name": "infrangible/m2-catalog-product-customer-price",
    "description": "Set individual prices or percentage discounts for specific customers and products, optionally limited in quantity or to one website; customers see and pay them when logged in.",
    "type": "magento2-module",
    "version": "4.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Pricing",
        "Customers",
        "customer-specific prices",
        "price per customer",
        "individual prices for B2B customers",
        "customer discounts per product"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-customer-price",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-backend-widget": "~4.0.4",
        "infrangible/m2-catalog-product-price-calculation": "~4.0.0",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-checkout": "~100.4.0",
        "magento/module-customer": "~103.0.0",
        "magento/module-quote": "~101.2.0",
        "magento/module-sales": "~103.0.0",
        "magento/module-store": "~101.1.0",
        "magento/module-ui": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductCustomerPrice\\": "src"
        }
    }
}
